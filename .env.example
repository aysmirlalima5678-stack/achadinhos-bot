# Chaves da API de Afiliados da Shopee (painel de afiliados > Open API)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Número do WhatsApp que vai mandar as mensagens (com 55 + DDD), ex: 5511999998888
WHATSAPP_NUMERO=

# (Opcional) Só se no config.json estiver "redator": "api" (API paga do Claude).
# No modo padrão ("assinatura") deixe em branco: o robô usa o Claude Code logado na sua conta.
ANTHROPIC_API_KEY=
